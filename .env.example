# OPTIONAL. The app runs fine without a .env file; every setting has a default.
# To change something, copy this file (cp .env.example .env) and edit it.
# .env is gitignored.

# Where the SQLite file lives (relative to the project folder).
INVENTORY_DATABASE_URL=sqlite:///./data/inventory.db

# How long a login lasts, in minutes (default: 12 hours = one shop day).
INVENTORY_SESSION_EXPIRE_MINUTES=720

# DEBUG, INFO, WARNING or ERROR
INVENTORY_LOG_LEVEL=INFO

# Low-stock alerts. Leave empty to only write alerts to the log.
# Set to a webhook URL (e.g. an ntfy.sh topic: https://ntfy.sh/your-topic-name)
# to get a phone notification when an item drops to its reorder level.
INVENTORY_LOW_STOCK_WEBHOOK_URL=
